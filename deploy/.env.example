# Variables de producción de Galpón Mates (tienda, dashboard y back).
#
# Copiá este archivo a `.env` en esta misma carpeta (`backend/deploy`) y completá cada valor.
# El `.env` no se sube a git: tiene secretos. Guardá una copia en un lugar seguro.
# El paso a paso está en `backend/docs/DESPLIEGUE-SERVIDOR-PROPIO.md`.
#
# Reglas para que no falle: sin espacios alrededor del `=`, sin comillas (salvo donde el ejemplo
# las trae) y sin dejar ninguna línea obligatoria vacía.

# ── Dominio ─────────────────────────────────────────────────────────────────────────────────
# El dominio sin `https://` ni `www`. La tienda queda en https://DOMAIN, el dashboard en
# https://admin.DOMAIN y el back en https://api.DOMAIN.
DOMAIN=tudominio.com.ar

# Tu mail: Let's Encrypt lo usa para avisarte si un certificado HTTPS está por vencer.
ACME_EMAIL=vos@tudominio.com.ar

# ── Secretos propios (los inventás vos) ─────────────────────────────────────────────────────
# Contraseña de la base de datos. Solo letras y números (va adentro de una URL).
# Generala en el servidor con:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Secreto compartido entre el back y la tienda para regenerar páginas. 32 caracteres o más.
# Generalo con:  openssl rand -hex 32
REVALIDATE_SECRET=

# ── Mercado Pago (panel "Tus integraciones" > tu aplicación) ────────────────────────────────
# Credenciales de producción > Access Token (empieza con APP_USR-). Es secreto.
MP_ACCESS_TOKEN=

# Credenciales de producción > Public Key (empieza con APP_USR-). La ve el navegador.
MP_PUBLIC_KEY=

# Webhooks > Clave secreta. Aparece después de configurar la URL
# https://api.DOMAIN/api/v1/webhooks/mercadopago con el evento "Pagos".
MP_WEBHOOK_SECRET=

# Texto que sale en el resumen de la tarjeta del cliente, hasta 13 caracteres.
MP_STATEMENT_DESCRIPTOR=GALPON MATES

# ── Cloudinary (panel > Settings > API Keys) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mails (los datos SMTP que te da el servicio de envío) ───────────────────────────────────
SMTP_HOST=
# 587 (lo más común) o 465.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente de los mails, con comillas. La dirección tiene que ser de un dominio verificado en
# el servicio de envío.
MAIL_FROM="Galpón Mates <hola@tudominio.com.ar>"

# ── Opcionales ──────────────────────────────────────────────────────────────────────────────
# Nivel de log del back: debug, info, warn o error.
LOG_LEVEL=info

# Cuántos días se guardan las copias diarias de la base.
BACKUP_KEEP_DAYS=14

# ── Solo para crear el admin del dashboard (el seed) ────────────────────────────────────────
# Se usan una sola vez, con `docker compose --profile tools run --rm tools npm run db:seed`.
# La contraseña: 12 caracteres o más. Después de sembrar, borrá estas dos líneas.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
