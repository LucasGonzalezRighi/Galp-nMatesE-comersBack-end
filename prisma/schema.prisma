// Esquema de Galpón Mates (spec del back §4). Tablas en snake_case con @map/@@map; ids uuid v7
// generados por la app; montos enteros en pesos con sufijo _ars; fechas timestamptz.
// Lo que Prisma no sabe expresar (extensión citext, CHECK, índices parciales y la secuencia de
// números de pedido) está escrito a mano en las migraciones b2_catalogo_contenido, b3_identidad,
// b4_pedidos y b5_pagos.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7: la URL de conexión vive en prisma.config.ts (CLI) y en el driver adapter (app).
datasource db {
  provider = "postgresql"
}

/// Grupo de productos del catálogo.
enum ProductGroup {
  mate
  bombilla
  yerba

  @@map("product_group")
}

/// Estado de publicación de un producto.
enum ProductStatus {
  draft
  published
  archived

  @@map("product_status")
}

/// Estado de moderación de una reseña.
enum ReviewStatus {
  pending
  approved
  hidden

  @@map("review_status")
}

/// Estado de una clave de idempotencia.
enum IdempotencyStatus {
  processing
  completed

  @@map("idempotency_status")
}

/// Método de envío del contrato; el orden de declaración es el orden en que se muestran.
enum ShippingMethod {
  home
  branch
  pickup

  @@map("shipping_method")
}

/// Rol de un usuario: quien compra en la tienda o quien administra el panel.
enum UserRole {
  customer
  admin

  @@map("user_role")
}

/// Estado de una cuenta: una deshabilitada no puede iniciar sesión.
enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// Provincia o jurisdicción de entrega: las 24 del contrato, guardadas con su texto exacto.
enum Province {
  buenos_aires        @map("Buenos Aires")
  caba                @map("CABA")
  catamarca           @map("Catamarca")
  chaco               @map("Chaco")
  chubut              @map("Chubut")
  cordoba             @map("Córdoba")
  corrientes          @map("Corrientes")
  entre_rios          @map("Entre Ríos")
  formosa             @map("Formosa")
  jujuy               @map("Jujuy")
  la_pampa            @map("La Pampa")
  la_rioja            @map("La Rioja")
  mendoza             @map("Mendoza")
  misiones            @map("Misiones")
  neuquen             @map("Neuquén")
  rio_negro           @map("Río Negro")
  salta               @map("Salta")
  san_juan            @map("San Juan")
  san_luis            @map("San Luis")
  santa_cruz          @map("Santa Cruz")
  santa_fe            @map("Santa Fe")
  santiago_del_estero @map("Santiago del Estero")
  tierra_del_fuego    @map("Tierra del Fuego")
  tucuman             @map("Tucumán")

  @@map("province")
}

/// Estado de un pedido (contrato `OrderStatus`): `pending_payment` espera el pago con el stock
/// reservado; `expired` es una reserva que venció sin pago.
enum OrderStatus {
  pending_payment
  paid
  preparing
  shipped
  delivered
  cancelled
  expired
  refunded

  @@map("order_status")
}

/// Estado del pago de un pedido, ya traducido desde Mercado Pago (contrato `PaymentStatus`):
/// `none` es que todavía no hubo ningún intento.
enum PaymentStatus {
  none
  pending
  action_required
  approved
  rejected
  cancelled
  refunded
  partially_refunded
  in_dispute
  charged_back

  @@map("payment_status")
}

/// Forma de pago elegida en el checkout (contrato `PaymentMethod`).
enum PaymentMethod {
  mp_redirect
  card

  @@map("payment_method")
}

/// Tipo de línea de un pedido: un producto suelto o un kit de mate, bombilla y yerba.
enum LineType {
  product
  kit

  @@map("line_type")
}

/// Quién hizo un cambio de estado de un pedido.
enum OrderActor {
  system
  admin
  customer
  provider

  @@map("order_actor")
}

/// Estado de la reserva de stock de un producto para un pedido: `active` mientras espera el pago,
/// `committed` cuando el pago lo descuenta del stock y `released` cuando se devuelve.
enum ReservationStatus {
  active
  committed
  released

  @@map("reservation_status")
}

/// Pasarela de un intento de pago o de un evento de webhook (por ahora solo Mercado Pago).
enum PaymentProvider {
  mercadopago

  @@map("payment_provider")
}

/// Estado de una devolución: `pending` antes de pedirla a la pasarela, `approved` cuando la
/// confirma y `failed` si la rechazó (queda la alerta "Devolvelo desde Mercado Pago" del admin).
enum RefundStatus {
  pending
  approved
  failed

  @@map("refund_status")
}

/// Por qué se devuelve un pago: un segundo pago aprobado de un pedido ya pagado, un pago aprobado
/// después de que el pedido venció o se canceló, o una devolución hecha a mano desde el admin.
enum RefundReason {
  duplicate_payment
  late_approval
  manual

  @@map("refund_reason")
}

// ── Identidad (spec §4.1) ───────────────────────────────────────────────────────────────────

/// Cuenta con contraseña (argon2id): un cliente registrado o un admin.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  role            UserRole
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer            Customer?
  passwordResetTokens PasswordResetToken[]
  editedContentBlocks ContentBlock[]

  @@map("users")
}

/// La persona que compra. Un invitado es un cliente sin `userId`; si después se registra con el
/// mismo email, se vincula y sus compras quedan asociadas.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  email          String   @unique @db.Citext
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  documentType   String?  @map("document_type")
  documentNumber String?  @map("document_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses Address[]
  reviews   Review[]
  orders    Order[]

  @@map("customers")
}

/// Dirección de la libreta de un cliente. Una sola predeterminada por cliente: índice único
/// parcial `addresses_default_per_customer_idx` en la migración.
model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?
  street     String
  number     String
  apartment  String?
  postalCode String   @map("postal_code")
  city       String
  province   Province
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

/// Token de recuperación de contraseña: se guarda solo su SHA-256, vence y es de un solo uso.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Catálogo y stock (spec §4.2) ────────────────────────────────────────────────────────────

/// Línea del catálogo (Imperiales, Torpedos, Bombillones…).
model Category {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  name      String
  group     ProductGroup
  blurb     String
  imageId   String?      @map("image_id") @db.Uuid
  position  Int
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  image    MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([imageId])
  @@map("categories")
}

/// Producto del catálogo. `sequence` es el correlativo del que sale el código "N°07".
model Product {
  id           String        @id @default(uuid(7)) @db.Uuid
  sequence     Int           @unique @default(autoincrement())
  slug         String        @unique
  categoryId   String        @map("category_id") @db.Uuid
  name         String
  description  String
  /// Precio en pesos enteros; `null` es "a consultar".
  priceArs     Int?          @map("price_ars")
  status       ProductStatus @default(draft)
  featured     Boolean       @default(false)
  /// Textos propios de las pestañas Materiales y Cuidado, o `null` para usar los del grupo.
  tabsOverride Json?         @map("tabs_override")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  inventory    Inventory?
  reviews      Review[]
  slugHistory  ProductSlugHistory[]
  orderItems   OrderItem[]
  components   OrderItemComponent[]
  reservations StockReservation[]

  @@index([status, categoryId])
  @@index([categoryId])
  @@map("products")
}

/// Slug anterior de un producto renombrado: la tienda lo redirige al actual.
model ProductSlugHistory {
  slug      String   @id
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_history")
}

/// Foto subida a un proveedor (`local` en desarrollo, Cloudinary después).
model MediaAsset {
  id        String   @id @default(uuid(7)) @db.Uuid
  provider  String
  publicId  String   @unique @map("public_id")
  url       String
  width     Int
  height    Int
  alt       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories    Category[]
  productImages ProductImage[]

  @@map("media_assets")
}

/// Foto de la galería de un producto; la de `position` 1 es la principal.
model ProductImage {
  productId    String @map("product_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  position     Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([productId, position])
  @@index([mediaAssetId])
  @@map("product_images")
}

/// Stock de un producto. Disponible = `onHand - reserved`; CHECK `0 <= reserved <= on_hand` en
/// la migración. `version` sirve para el bloqueo optimista.
model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

/// Unidades de un producto apartadas para un pedido hasta `expiresAt` (= `orders.reserved_until`):
/// una fila por producto y pedido, sumando sus líneas sueltas y las piezas de sus kits. Acompaña al
/// contador `inventory.reserved`. CHECK `quantity >= 1` en la migración.
model StockReservation {
  id        String            @id @default(uuid(7)) @db.Uuid
  orderId   String            @map("order_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(active)
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@index([productId])
  @@map("stock_reservations")
}

// ── Pedidos (spec §4.3) ─────────────────────────────────────────────────────────────────────

/// Pedido de la tienda. Todo lo que muestra se copia al comprar (contacto, dirección, envío, forma
/// de pago, descuento de kits, nombres y precios) para que no cambie si después cambia el catálogo
/// o los ajustes. CHECK `orders_totals_check` en la migración: `subtotal = bruto − ahorro de kits`
/// y `total = subtotal + envío`.
model Order {
  id                 String         @id @default(uuid(7)) @db.Uuid
  /// `GLP-` + 5 dígitos, de la secuencia `order_number_seq` (arranca en 10001).
  number             String         @unique
  /// Dueño del pedido: el cliente de la sesión o el invitado del email; `null` si el email es de
  /// una cuenta y no había sesión (solo se lee con el token).
  customerId         String?        @map("customer_id") @db.Uuid
  status             OrderStatus    @default(pending_payment)
  paymentStatus      PaymentStatus  @default(none) @map("payment_status")
  paymentMethod      PaymentMethod  @map("payment_method")
  contactEmail       String         @map("contact_email") @db.Citext
  contactFirstName   String         @map("contact_first_name")
  contactLastName    String         @map("contact_last_name")
  contactPhone       String?        @map("contact_phone")
  shippingMethod     ShippingMethod @map("shipping_method")
  /// Copia de la dirección de entrega (completa en `home`, código postal, ciudad y provincia en
  /// `branch`); `null` en `pickup`.
  shippingAddress    Json?          @map("shipping_address")
  shippingCostArs    Int            @map("shipping_cost_ars")
  /// Plazo de entrega vigente al comprar.
  shippingEta        String         @map("shipping_eta")
  itemsGrossArs      Int            @map("items_gross_ars")
  kitSavingsArs      Int            @map("kit_savings_ars")
  subtotalArs        Int            @map("subtotal_ars")
  totalArs           Int            @map("total_ars")
  kitDiscountPercent Int            @map("kit_discount_percent")
  /// SHA-256 del `orderToken` que se entrega al crear el pedido (el token nunca se guarda).
  accessTokenHash    String         @unique @map("access_token_hash")
  /// Hasta cuándo se guarda el stock sin pago: creación + 30 minutos; no cambia nunca.
  reservedUntil      DateTime       @map("reserved_until") @db.Timestamptz(3)
  placedAt           DateTime       @default(now()) @map("placed_at") @db.Timestamptz(3)
  paidAt             DateTime?      @map("paid_at") @db.Timestamptz(3)
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  history      OrderStatusHistory[]
  shipment     Shipment?
  reservations StockReservation[]
  payments     Payment[]

  @@index([customerId, placedAt])
  @@index([status, reservedUntil])
  @@map("orders")
}

/// Línea de un pedido, en el orden del carrito (`position`). En un kit `productId` y
/// `productSlug` son `null` y las piezas van en `OrderItemComponent`. CHECK
/// `order_items_quantity_check` (1 a 20) en la migración.
model OrderItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  lineType      LineType @map("line_type")
  productId     String?  @map("product_id") @db.Uuid
  /// Slug del producto al comprar.
  productSlug   String?  @map("product_slug")
  name          String
  detail        String
  quantity      Int
  unitPriceArs  Int      @map("unit_price_ars")
  kitSavingsArs Int      @map("kit_savings_ars")
  totalArs      Int      @map("total_ars")
  /// Cuero y virola (`{ leather, ferrule }`) de un mate o de un kit; `null` en el resto.
  options       Json?
  position      Int

  order      Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  components OrderItemComponent[]
  review     Review?

  @@unique([orderId, position])
  @@index([productId])
  @@map("order_items")
}

/// Pieza de un kit (mate, bombilla o yerba), con su slug, nombre y precio al comprar.
model OrderItemComponent {
  orderItemId  String       @map("order_item_id") @db.Uuid
  role         ProductGroup
  productId    String       @map("product_id") @db.Uuid
  slug         String
  name         String
  unitPriceArs Int          @map("unit_price_ars")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderItemId, role])
  @@index([productId])
  @@map("order_item_components")
}

/// Cambio de estado de un pedido, del más viejo al más nuevo. La creación deja la primera fila
/// (`fromStatus` null, `toStatus` `pending_payment`).
model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actor      OrderActor
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Envío despachado de un pedido (lo carga el admin; el contrato lo muestra como `tracking`).
model Shipment {
  orderId        String    @id @map("order_id") @db.Uuid
  carrier        String
  trackingNumber String    @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

// ── Pagos (spec §4.4) ───────────────────────────────────────────────────────────────────────

/// Intento de pago de un pedido con la pasarela, uno por fila. `status` es el estado ya traducido
/// (el mismo enum que `orders.payment_status`); `providerStatus` y `statusDetail`, los crudos de
/// Mercado Pago. Solo un intento activo por pedido (`isActive`: `none`, `pending` o
/// `action_required`): índice único parcial `payments_active_per_order_idx` en la migración.
model Payment {
  id                   String          @id @default(uuid(7)) @db.Uuid
  orderId              String          @map("order_id") @db.Uuid
  provider             PaymentProvider @default(mercadopago)
  method               PaymentMethod
  status               PaymentStatus   @default(none)
  /// `status` de Mercado Pago (`approved`, `in_process`, `rejected`…).
  providerStatus       String?         @map("provider_status")
  /// `status_detail` de Mercado Pago (`accredited`, `pending_challenge`, `cc_rejected_…`).
  statusDetail         String?         @map("status_detail")
  /// Id del pago en Mercado Pago; `null` mientras una preferencia no tiene pago.
  providerPaymentId    String?         @map("provider_payment_id")
  /// Id de la preferencia de Checkout Pro (solo `mp_redirect`).
  providerPreferenceId String?         @map("provider_preference_id")
  /// URL de Checkout Pro a la que se manda al comprador (solo `mp_redirect`).
  initPoint            String?         @map("init_point")
  /// URL del desafío 3-D Secure, mientras el intento está `action_required`.
  challengeUrl         String?         @map("challenge_url")
  /// Monto del intento (el `totalArs` del pedido al crearlo).
  amountArs            Int             @map("amount_ars")
  /// Total devuelto de este pago.
  refundedArs          Int             @default(0) @map("refunded_ars")
  installments         Int?
  /// `payment_type_id` de Mercado Pago (`credit_card`, `debit_card`, `account_money`…).
  paymentTypeId        String?         @map("payment_type_id")
  /// Marca de la tarjeta (`visa`, `master`…).
  cardBrand            String?         @map("card_brand")
  cardLastFour         String?         @map("card_last_four")
  issuerId             String?         @map("issuer_id")
  payerEmail           String?         @map("payer_email")
  /// `Idempotency-Key` que mandó la tienda; se reenvía a Mercado Pago como `X-Idempotency-Key`.
  idempotencyKey       String          @unique @map("idempotency_key")
  isActive             Boolean         @default(true) @map("is_active")
  approvedAt           DateTime?       @map("approved_at") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([providerPreferenceId])
  @@map("payments")
}

/// Devolución de un pago. La fila se crea (`pending`, con su propia clave idempotente) antes de
/// pedirla a la pasarela; si la pasarela falla queda `failed` con `lastError`.
model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  /// Id de la devolución en Mercado Pago, cuando la confirma.
  providerRefundId String?      @unique @map("provider_refund_id")
  amountArs        Int          @map("amount_ars")
  status           RefundStatus @default(pending)
  reason           RefundReason
  /// `X-Idempotency-Key` de la devolución (distinta de la del pago).
  idempotencyKey   String       @unique @map("idempotency_key")
  lastError        String?      @map("last_error")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

/// Notificación recibida de la pasarela, registrada una sola vez por `(provider, eventId)`
/// (`eventId`: el `id` del cuerpo o, si no viene, el `x-request-id`) y procesada en la cola
/// `payment-webhooks`.
model WebhookEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  provider       PaymentProvider
  eventId        String          @map("event_id")
  /// `type` de la notificación (`payment`, `merchant_order`…).
  type           String
  /// `action` de la notificación (`payment.created`, `payment.updated`…).
  action         String?
  /// `data.id`: el id del recurso avisado (para `payment`, el id del pago en Mercado Pago).
  resourceId     String?         @map("resource_id")
  signatureValid Boolean         @map("signature_valid")
  /// Cuerpo de la notificación tal como llegó.
  payload        Json
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(3)
  attempts       Int             @default(0)
  lastError      String?         @map("last_error")

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

// ── Comunidad, soporte y plataforma (spec §4.5) ─────────────────────────────────────────────

/// Reseña de un producto. `rating` admite medias estrellas (CHECK en la migración).
/// `customerId` apunta al cliente (queda en null si se lo borra) y `orderItemId` a la línea del
/// pedido que se reseña (queda en null si se borra el pedido). `verifiedPurchase` guarda la "compra
/// verificada" que devuelve el contrato: el seed la fija a mano (no siembra pedidos) y desde B7 se
/// calcula con `orderItemId` (si existe, es `true`).
model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  customerId       String?      @map("customer_id") @db.Uuid
  orderItemId      String?      @unique @map("order_item_id") @db.Uuid
  authorName       String       @map("author_name")
  rating           Decimal      @db.Decimal(2, 1)
  text             String
  status           ReviewStatus @default(pending)
  featured         Boolean      @default(false)
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

/// Contenido editable por clave (`home`, `about`, `faq`, `footer`, `product-tabs`,
/// `legal-terms`, `legal-privacy`); `data` lo valida el schema de cada contenido.
model ContentBlock {
  key       String   @id
  data      Json
  version   Int      @default(1)
  /// Usuario admin que lo editó por última vez (null si nunca se editó o si se borró el usuario).
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("content_blocks")
}

/// Ajustes de la tienda: fila única con `id = 1` (CHECK en la migración).
model Settings {
  id                        Int      @id @default(1)
  kitDiscountPercent        Int      @map("kit_discount_percent")
  installmentsMax           Int      @map("installments_max")
  installmentsShowOnProduct Boolean  @map("installments_show_on_product")
  contactEmail              String   @map("contact_email")
  lowStockThreshold         Int      @map("low_stock_threshold")
  /// Alícuota de IVA en porcentaje, con decimales si hace falta (10,5).
  vatRatePercent            Decimal  @map("vat_rate_percent") @db.Decimal(5, 2)
  showNetPrice              Boolean  @map("show_net_price")
  /// Datos del vendedor (`legalName`, `cuit`, `taxCondition`…), con `null` en lo no cargado.
  seller                    Json
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Opción de envío que se ofrece en el checkout.
model ShippingOption {
  method    ShippingMethod @id
  label     String
  costArs   Int            @map("cost_ars")
  eta       String
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shipping_options")
}

/// Evento de dominio pendiente de publicar en la cola `outbox` (índice parcial de los no
/// publicados en la migración).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  type          String
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)

  @@map("outbox_events")
}

/// Clave `Idempotency-Key` de un pedido HTTP, por alcance (spec §5).
model IdempotencyKey {
  scope          String
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  lockedUntil    DateTime?         @map("locked_until") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@map("idempotency_keys")
}
