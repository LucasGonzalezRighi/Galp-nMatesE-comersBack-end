// Esquema de Galpón Mates (spec del back §4). Tablas en snake_case con @map/@@map; ids uuid v7
// generados por la app; montos enteros en pesos con sufijo _ars; fechas timestamptz.
// Lo que Prisma no sabe expresar (extensión citext, CHECK e índices parciales) está escrito a mano
// en las migraciones b2_catalogo_contenido y b3_identidad.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7: la URL de conexión vive en prisma.config.ts (CLI) y en el driver adapter (app).
datasource db {
  provider = "postgresql"
}

/// Grupo de productos del catálogo.
enum ProductGroup {
  mate
  bombilla
  yerba

  @@map("product_group")
}

/// Estado de publicación de un producto.
enum ProductStatus {
  draft
  published
  archived

  @@map("product_status")
}

/// Estado de moderación de una reseña.
enum ReviewStatus {
  pending
  approved
  hidden

  @@map("review_status")
}

/// Estado de una clave de idempotencia.
enum IdempotencyStatus {
  processing
  completed

  @@map("idempotency_status")
}

/// Método de envío del contrato; el orden de declaración es el orden en que se muestran.
enum ShippingMethod {
  home
  branch
  pickup

  @@map("shipping_method")
}

/// Rol de un usuario: quien compra en la tienda o quien administra el panel.
enum UserRole {
  customer
  admin

  @@map("user_role")
}

/// Estado de una cuenta: una deshabilitada no puede iniciar sesión.
enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// Provincia o jurisdicción de entrega: las 24 del contrato, guardadas con su texto exacto.
enum Province {
  buenos_aires        @map("Buenos Aires")
  caba                @map("CABA")
  catamarca           @map("Catamarca")
  chaco               @map("Chaco")
  chubut              @map("Chubut")
  cordoba             @map("Córdoba")
  corrientes          @map("Corrientes")
  entre_rios          @map("Entre Ríos")
  formosa             @map("Formosa")
  jujuy               @map("Jujuy")
  la_pampa            @map("La Pampa")
  la_rioja            @map("La Rioja")
  mendoza             @map("Mendoza")
  misiones            @map("Misiones")
  neuquen             @map("Neuquén")
  rio_negro           @map("Río Negro")
  salta               @map("Salta")
  san_juan            @map("San Juan")
  san_luis            @map("San Luis")
  santa_cruz          @map("Santa Cruz")
  santa_fe            @map("Santa Fe")
  santiago_del_estero @map("Santiago del Estero")
  tierra_del_fuego    @map("Tierra del Fuego")
  tucuman             @map("Tucumán")

  @@map("province")
}

// ── Identidad (spec §4.1) ───────────────────────────────────────────────────────────────────

/// Cuenta con contraseña (argon2id): un cliente registrado o un admin.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String     @map("password_hash")
  role            UserRole
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer            Customer?
  passwordResetTokens PasswordResetToken[]
  editedContentBlocks ContentBlock[]

  @@map("users")
}

/// La persona que compra. Un invitado es un cliente sin `userId`; si después se registra con el
/// mismo email, se vincula y sus compras quedan asociadas.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  email          String   @unique @db.Citext
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  phone          String?
  documentType   String?  @map("document_type")
  documentNumber String?  @map("document_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses Address[]
  reviews   Review[]

  @@map("customers")
}

/// Dirección de la libreta de un cliente. Una sola predeterminada por cliente: índice único
/// parcial `addresses_default_per_customer_idx` en la migración.
model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?
  street     String
  number     String
  apartment  String?
  postalCode String   @map("postal_code")
  city       String
  province   Province
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

/// Token de recuperación de contraseña: se guarda solo su SHA-256, vence y es de un solo uso.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── Catálogo y stock (spec §4.2) ────────────────────────────────────────────────────────────

/// Línea del catálogo (Imperiales, Torpedos, Bombillones…).
model Category {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  name      String
  group     ProductGroup
  blurb     String
  imageId   String?      @map("image_id") @db.Uuid
  position  Int
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  image    MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([imageId])
  @@map("categories")
}

/// Producto del catálogo. `sequence` es el correlativo del que sale el código "N°07".
model Product {
  id           String        @id @default(uuid(7)) @db.Uuid
  sequence     Int           @unique @default(autoincrement())
  slug         String        @unique
  categoryId   String        @map("category_id") @db.Uuid
  name         String
  description  String
  /// Precio en pesos enteros; `null` es "a consultar".
  priceArs     Int?          @map("price_ars")
  status       ProductStatus @default(draft)
  featured     Boolean       @default(false)
  /// Textos propios de las pestañas Materiales y Cuidado, o `null` para usar los del grupo.
  tabsOverride Json?         @map("tabs_override")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category    Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  inventory   Inventory?
  reviews     Review[]
  slugHistory ProductSlugHistory[]

  @@index([status, categoryId])
  @@index([categoryId])
  @@map("products")
}

/// Slug anterior de un producto renombrado: la tienda lo redirige al actual.
model ProductSlugHistory {
  slug      String   @id
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_history")
}

/// Foto subida a un proveedor (`local` en desarrollo, Cloudinary después).
model MediaAsset {
  id        String   @id @default(uuid(7)) @db.Uuid
  provider  String
  publicId  String   @unique @map("public_id")
  url       String
  width     Int
  height    Int
  alt       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories    Category[]
  productImages ProductImage[]

  @@map("media_assets")
}

/// Foto de la galería de un producto; la de `position` 1 es la principal.
model ProductImage {
  productId    String @map("product_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  position     Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([productId, position])
  @@index([mediaAssetId])
  @@map("product_images")
}

/// Stock de un producto. Disponible = `onHand - reserved`; CHECK `0 <= reserved <= on_hand` en
/// la migración. `version` sirve para el bloqueo optimista.
model Inventory {
  productId String   @id @map("product_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ── Comunidad, soporte y plataforma (spec §4.5) ─────────────────────────────────────────────

/// Reseña de un producto. `rating` admite medias estrellas (CHECK en la migración).
/// `customerId` apunta al cliente (queda en null si se lo borra); `orderItemId` queda sin FK hasta
/// B4. `verifiedPurchase` guarda la "compra
/// verificada" que devuelve el contrato: el seed la fija a mano (no hay pedidos todavía) y desde B4
/// se calcula con `orderItemId` (si existe, es `true`).
model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  customerId       String?      @map("customer_id") @db.Uuid
  orderItemId      String?      @unique @map("order_item_id") @db.Uuid
  authorName       String       @map("author_name")
  rating           Decimal      @db.Decimal(2, 1)
  text             String
  status           ReviewStatus @default(pending)
  featured         Boolean      @default(false)
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

/// Contenido editable por clave (`home`, `about`, `faq`, `footer`, `product-tabs`,
/// `legal-terms`, `legal-privacy`); `data` lo valida el schema de cada contenido.
model ContentBlock {
  key       String   @id
  data      Json
  version   Int      @default(1)
  /// Usuario admin que lo editó por última vez (null si nunca se editó o si se borró el usuario).
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("content_blocks")
}

/// Ajustes de la tienda: fila única con `id = 1` (CHECK en la migración).
model Settings {
  id                        Int      @id @default(1)
  kitDiscountPercent        Int      @map("kit_discount_percent")
  installmentsMax           Int      @map("installments_max")
  installmentsShowOnProduct Boolean  @map("installments_show_on_product")
  contactEmail              String   @map("contact_email")
  lowStockThreshold         Int      @map("low_stock_threshold")
  /// Alícuota de IVA en porcentaje, con decimales si hace falta (10,5).
  vatRatePercent            Decimal  @map("vat_rate_percent") @db.Decimal(5, 2)
  showNetPrice              Boolean  @map("show_net_price")
  /// Datos del vendedor (`legalName`, `cuit`, `taxCondition`…), con `null` en lo no cargado.
  seller                    Json
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Opción de envío que se ofrece en el checkout.
model ShippingOption {
  method    ShippingMethod @id
  label     String
  costArs   Int            @map("cost_ars")
  eta       String
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shipping_options")
}

/// Evento de dominio pendiente de publicar en la cola `outbox` (índice parcial de los no
/// publicados en la migración).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  type          String
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)

  @@map("outbox_events")
}

/// Clave `Idempotency-Key` de un pedido HTTP, por alcance (spec §5).
model IdempotencyKey {
  scope          String
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  lockedUntil    DateTime?         @map("locked_until") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@map("idempotency_keys")
}
