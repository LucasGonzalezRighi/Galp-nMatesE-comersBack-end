# Variables de entorno del back de Galpón Mates.
# Copiá este archivo a .env (no se versiona): `npm run dev` lo carga al arrancar, y las variables
# que ya estén definidas en el entorno tienen prioridad. Si falta una obligatoria o tiene un valor
# inválido, la API no levanta y el error dice cuál.

# Entorno: development, test o production. En test el logger no escribe nada.
NODE_ENV=development

# Puerto HTTP. La tienda y el admin esperan el back en http://localhost:3001.
PORT=3001

# Obligatoria. Postgres de desarrollo (el de docker compose).
DATABASE_URL=postgresql://galpon:galpon@localhost:5432/galpon

# Obligatoria. Redis de desarrollo (el de docker compose): caché, rate limiting y colas.
REDIS_URL=redis://localhost:6379

# Origen del admin: el único al que se le habilita CORS con credenciales.
ADMIN_ORIGIN=http://localhost:5173

# Origen de la tienda (Next.js). Arma el link de recuperación de contraseña
# (`${STORE_ORIGIN}/cuenta/restablecer?token=…`): si probás la tienda compilada en otro puerto
# (por ejemplo el 4300), arrancá el back con ese origen para que el link apunte ahí.
STORE_ORIGIN=http://localhost:3000

# Secreto compartido con la tienda para `POST ${STORE_ORIGIN}/api/revalidate` (cabecera
# `x-revalidate-secret`): el mismo `REVALIDATE_SECRET` de la tienda, 32 caracteres o más.
# Obligatorio en producción; sin él, la tienda se actualiza sola cada hora. Nunca se loguea.
# STORE_REVALIDATE_SECRET=

# Nivel mínimo de log: debug, info, warn o error.
LOG_LEVEL=info

# ── Pagos con Mercado Pago ──────────────────────────────────────────────────────────────────
# Pasarela: simulated (por defecto; el simulador del back, sin credenciales) o live (Mercado Pago
# real). En production tiene que ser live.
MP_MODE=simulated

# Con MP_MODE=live hacen falta las tres (las da Lucas; nunca se versionan):
# - Access token de Mercado Pago (de prueba o productivo: hoy los dos empiezan con APP_USR-…).
#   Nunca se loguea.
# MP_ACCESS_TOKEN=
# - Clave secreta de las notificaciones (panel de Mercado Pago > Webhooks): firma x-signature.
# MP_WEBHOOK_SECRET=
# - Origen público HTTPS de este back, sin ruta ni barra final: Mercado Pago avisa los pagos en
#   ${PUBLIC_API_ORIGIN}/api/v1/webhooks/mercadopago. En simulated, si falta, el simulador usa
#   http://localhost:${PORT}.
# PUBLIC_API_ORIGIN=https://api.ejemplo.com

# Texto del resumen de la tarjeta, hasta 13 caracteres.
MP_STATEMENT_DESCRIPTOR="GALPON MATES"

# ── Fotos del dashboard (Cloudinary) ────────────────────────────────────────────────────────
# Modo: simulated (por defecto; firma como el mock y arma las URL con la nube galpon-mock) o
# cloudinary (firma las subidas con las credenciales de abajo). En production tiene que ser
# cloudinary. El back nunca llama a la Admin API de Cloudinary: arma la URL con la nube y el
# publicId, y acepta una foto si está en la carpeta de su uso (galpon/productos/, galpon/lineas/,
# galpon/socios/ o galpon/sitio/).
MEDIA_MODE=simulated

# Con MEDIA_MODE=cloudinary hacen falta las tres (panel de Cloudinary > API Keys; nunca se
# versionan). El secreto nunca se loguea.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
