# Variables de entorno del back de Galpón Mates.
# Copiá este archivo a .env (no se versiona): `npm run dev` lo carga al arrancar, y las variables
# que ya estén definidas en el entorno tienen prioridad. Si falta una obligatoria o tiene un valor
# inválido, la API no levanta y el error dice cuál.

# Entorno: development, test o production. En test el logger no escribe nada.
NODE_ENV=development

# Puerto HTTP. La tienda y el admin esperan el back en http://localhost:3001.
PORT=3001

# Obligatoria. Postgres de desarrollo (el de docker compose).
DATABASE_URL=postgresql://galpon:galpon@localhost:5432/galpon

# Obligatoria. Redis de desarrollo (el de docker compose): caché, rate limiting y colas.
REDIS_URL=redis://localhost:6379

# Origen del admin: el único al que se le habilita CORS con credenciales.
ADMIN_ORIGIN=http://localhost:5173

# Origen de la tienda (Next.js).
STORE_ORIGIN=http://localhost:3000

# Nivel mínimo de log: debug, info, warn o error.
LOG_LEVEL=info
