# Variables de entorno del back de Galpón Mates.
# Copiá este archivo a .env (no se versiona): `npm run dev` lo carga al arrancar, y las variables
# que ya estén definidas en el entorno tienen prioridad. Si falta una obligatoria o tiene un valor
# inválido, la API no levanta y el error dice cuál.

# Obligatoria y explícita: development, test o production. Sin NODE_ENV la API no arranca ni corre
# el seed (así un despliegue nunca queda como desarrollo por olvido). En test el logger no escribe.
NODE_ENV=development

# Interfaz en la que escucha la API: una IP o localhost. Por defecto 127.0.0.1 fuera de producción
# (solo esta máquina) y 0.0.0.0 en producción (detrás del proxy o del contenedor).
# HOST=127.0.0.1

# Puerto HTTP. La tienda y el admin esperan el back en http://localhost:3001.
PORT=3001

# Proxies de confianza (apagada si falta o está vacía): IPs o redes CIDR separadas por comas, o
# loopback, linklocal o uniquelocal. Con la lista, los límites por IP cuentan la IP real del
# cliente (la de X-Forwarded-For, saltando solo estos proxies) y se activan los límites de las
# lecturas públicas y el cupo diario de reseñas. Poné solo proxies que escriban la IP real del
# cliente en X-Forwarded-For (por ejemplo el servidor de la tienda detrás de un proxy que la pone):
# si no, cualquiera puede inventarse una. Ver "Proxies de confianza" en el README.
# TRUST_PROXY=10.0.0.5

# Obligatoria. Postgres de desarrollo (el de docker compose).
DATABASE_URL=postgresql://galpon:galpon@localhost:5432/galpon

# Obligatoria. Redis de desarrollo (el de docker compose): caché, rate limiting y colas.
REDIS_URL=redis://localhost:6379

# Origen del admin: el único al que se le habilita CORS con credenciales. En producción es
# obligatorio (por ejemplo https://admin.tudominio.com.ar): sin él la API no arranca.
ADMIN_ORIGIN=http://localhost:5173

# Origen de la tienda (Next.js). Arma el link de recuperación de contraseña
# (`${STORE_ORIGIN}/cuenta/restablecer?token=…`): si probás la tienda compilada en otro puerto
# (por ejemplo el 4300), arrancá el back con ese origen para que el link apunte ahí. En producción
# es obligatorio (por ejemplo https://tudominio.com.ar): sin él la API no arranca.
STORE_ORIGIN=http://localhost:3000

# Opcional: origen por el que el back le avisa a la tienda que regenere una página
# (`POST /api/revalidate`), cuando conviene no salir por el origen público. En el compose de
# producción es http://store:3000 (la red interna de Docker). Si falta, se usa STORE_ORIGIN.
# STORE_INTERNAL_ORIGIN=http://store:3000

# Secreto compartido con la tienda para `POST ${STORE_ORIGIN}/api/revalidate` (cabecera
# `x-revalidate-secret`): el mismo `REVALIDATE_SECRET` de la tienda, 32 caracteres o más.
# Obligatorio en producción; sin él, la tienda se actualiza sola cada hora. Nunca se loguea.
# STORE_REVALIDATE_SECRET=

# Nivel mínimo de log: debug, info, warn o error.
LOG_LEVEL=info

# Admin del panel que crea el seed (`npm run db:seed`; la API no las lee). Fuera de producción son
# opcionales: sin ellas, el seed crea el admin de demostración del front. En producción son
# obligatorias: la contraseña de 12 caracteres o más y distinta de la de demostración. Nunca se
# versionan. Las mismas dos sirven para `npm run admin:password`, que crea el admin o le cambia la
# contraseña sin tocar el catálogo (para recuperar el acceso en producción).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ── Pagos con Mercado Pago ──────────────────────────────────────────────────────────────────
# Pasarela: simulated (por defecto; el simulador del back, sin credenciales) o live (Mercado Pago
# real). En production tiene que ser live.
MP_MODE=simulated

# Con MP_MODE=live hacen falta las tres (las da Lucas; nunca se versionan):
# - Access token de Mercado Pago (de prueba o productivo: hoy los dos empiezan con APP_USR-…).
#   Nunca se loguea.
# MP_ACCESS_TOKEN=
# - Clave secreta de las notificaciones (panel de Mercado Pago > Webhooks): firma x-signature.
# MP_WEBHOOK_SECRET=
# - Origen público HTTPS de este back, sin ruta ni barra final: Mercado Pago avisa los pagos en
#   ${PUBLIC_API_ORIGIN}/api/v1/webhooks/mercadopago. En simulated, si falta, el simulador usa
#   http://localhost:${PORT}.
# PUBLIC_API_ORIGIN=https://api.ejemplo.com

# Texto del resumen de la tarjeta, hasta 13 caracteres.
MP_STATEMENT_DESCRIPTOR="GALPON MATES"

# ── Fotos del dashboard (Cloudinary) ────────────────────────────────────────────────────────
# Modo: simulated (por defecto; firma como el mock y arma las URL con la nube galpon-mock) o
# cloudinary (firma las subidas con las credenciales de abajo). En production tiene que ser
# cloudinary. El back nunca llama a la Admin API de Cloudinary: arma la URL con la nube y el
# publicId, y acepta una foto si está en la carpeta de su uso (galpon/productos/, galpon/lineas/,
# galpon/socios/ o galpon/sitio/).
MEDIA_MODE=simulated

# Con MEDIA_MODE=cloudinary hacen falta las tres (panel de Cloudinary > API Keys; nunca se
# versionan). El secreto nunca se loguea.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Mails (B7) ──────────────────────────────────────────────────────────────────────────────
# Modo: log (por defecto; no manda nada y deja en el log la plantilla y el destinatario
# enmascarado) o smtp (manda por el servidor de abajo, de cualquier proveedor). En production
# tiene que ser smtp: la confirmación del pedido por mail es obligatoria (CCyC 1108).
MAIL_MODE=log

# Con MAIL_MODE=smtp hacen falta las cinco. Puerto 465: TLS directo; 587: STARTTLS obligatorio
# (salvo en localhost, por ejemplo Mailpit en el 1025). La contraseña nunca se loguea.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Galpón Mates <hola@ejemplo.com>"
